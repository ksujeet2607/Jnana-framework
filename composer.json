{
    "name": "jnana/framework",
    "description": "Jnana — a lightweight PHP framework (routing, DI, HTTP, middleware, templating, security) framework.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Sujeet Kahar",
            "email": "kaha26sujeet@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "php-di/php-di": "^7.0",
        "tracy/tracy": "^2.10",
        "nikic/fast-route": "^1.3",
        "doctrine/dbal": "^3.6",
        "doctrine/orm": "^3.2",
        "symfony/console": "^6.4",
        "symfony/cache": "^6.4",
        "symfony/form": "^6.4",
        "symfony/validator": "^6.4",
        "symfony/security-csrf": "^6.4",
        "symfony/http-foundation": "^6.4",
        "dompdf/dompdf": "^2.0",
        "psr/log": "^3.0",
        "psr/container": "^2.0",
        "psr/cache": "^3.0",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Core\\": "core/",
            "Jnana\\": "jnana/"
        },
        "files": [
            "jnana/Helpers/Helpers.php",
            "jnana/Exceptions/exceptions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Jnana\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
